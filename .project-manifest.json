      "path": "web/result-table.js",
      "responsibility": "结果表及结构化证据明细"
    },
    {
      "id": "version_panel",
      "path": "web/version-panel.js",
      "responsibility": "封存选择、版本读取、比对和下载"
    }
  ],
  "workflows": [
    {
      "id": "target",
      "name": "环境换算",
      "entry": "POST /pipeatlas/api/evaluate 的 outputs.target",
      "steps": [
        "各音管目标频率随温度口径换算",
        "低音甲 的 频率（赫兹） 为 220"
      ],
      "success": "低音甲 的 频率（赫兹） 为 220",
      "failure": "非法领域数据返回 400；不产生伪造结果",
      "verification": "python3 -m pipeatlas.check_flow target",
      "module_ids": [
        "server",
        "contract",
        "service",
        "domain",
        "rules",
        "artifacts",
        "result_table",
        "harmonics",
        "allocation"
      ]
    },
    {
      "id": "candidate",
      "name": "泛音候选",
      "entry": "POST /pipeatlas/api/evaluate 的 outputs.candidate",
      "steps": [
        "同频峰可能属于两条音管",
        "峰乙 的 数量 为 2"
