{
  "project_name": "solo-0025-organ-partial-atlas",
  "project_shape": "fullstack",
  "modules": [
    {
      "id": "contract",
      "path": "pipeatlas/contract.py",
      "responsibility": "JSON 与领域字段边界"
    },
    {
      "id": "domain",
      "path": "pipeatlas/domain.py",
      "responsibility": "校验音管、开管名单、频峰与温度读数"
    },
    {
      "id": "rules",
      "path": "pipeatlas/rules.py",
      "responsibility": "消费归约证据和约束，产生业务判定"
    },
    {
      "id": "artifacts",
      "path": "pipeatlas/artifacts.py",
      "responsibility": "成果规范编码、摘要与差分"
    },
    {
      "id": "archive",
      "path": "pipeatlas/archive.py",
      "responsibility": "SQLite 历史版本与原子封存"
    },
    {
      "id": "service",
      "path": "pipeatlas/service.py",
      "responsibility": "串联归约、比对和历史读取"
    },
    {
      "id": "server",
      "path": "pipeatlas/server.py",
      "responsibility": "本机 HTTP 及静态界面入口"
    },
    {
      "id": "workbench",
      "path": "web/ui.js",
      "responsibility": "页面状态、样例归约、视图切换与图形编排"
    },
    {
      "id": "reconcile",
      "path": "pipeatlas/reconcile.py",
      "responsibility": "联合原始归约事实与业务判定，推导频峰争用组"
    },
    {
      "id": "sessions",
      "path": "pipeatlas/sessions.py",
      "responsibility": "复核证据归约"
    },
    {
      "id": "review",
      "path": "pipeatlas/review.py",
      "responsibility": "编排按领域事实驱动的可选复核"
    },
    {
      "id": "triage",
      "path": "pipeatlas/triage.py",
      "responsibility": "复核证据归约"
    },
    {
      "id": "harmonics",
      "path": "pipeatlas/harmonics.py",
      "responsibility": "温度修正的泛音槽及频峰候选图"
    },
    {
      "id": "allocation",
      "path": "pipeatlas/allocation.py",
      "responsibility": "双端唯一归属及槽位争用"
    },
    {
      "id": "take_evidence",
      "path": "pipeatlas/take_evidence.py",
