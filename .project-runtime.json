{
  "language": "Python 3.11+ / JavaScript ES modules",
  "project_shape": "fullstack",
  "source_extensions": [
    ".py",
    ".js",
    ".css",
    ".html"
  ],
  "build_command": "python3 -m compileall -q pipeatlas && node --input-type=module --check < web/ui.js && node --input-type=module --check < web/chart.js && node --input-type=module --check < web/result-table.js && node --input-type=module --check < web/version-panel.js",
